{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "web/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "^/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "^/docs",
      "dest": "/api/index.py"
    },
    {
      "src": "^/openapi.json",
      "dest": "/api/index.py"
    },
    {
      "src": "^/health",
      "dest": "/api/index.py"
    },
    {
      "src": "^/rider",
      "dest": "/web/rider.html"
    },
    {
      "src": "^/driver",
      "dest": "/web/driver.html"
    },
    {
      "src": "^/admin",
      "dest": "/web/admin.html"
    },
    {
      "src": "^/web/(.*)",
      "dest": "/web/$1"
    },
    {
      "src": "^/$",
      "dest": "/web/index.html"
    },
    {
      "src": "^/(.*)",
      "dest": "/web/$1"
    }
  ]
}
